# DBSync 环境配置示例
# 复制为 .env 后修改

# ---------------- 应用 ----------------
APP_NAME=数据库同步备份工具
DEBUG=false

# ---------------- 服务器 ----------------
HOST=0.0.0.0
PORT=8000

# ---------------- 控制面数据库 ----------------
DATABASE_URL=sqlite:///./data/dbsync.db

# ---------------- 备份 ----------------
BACKUP_DIR=./backups
MAX_BACKUP_FILES=100
BACKUP_TIMEOUT=3600

# ---------------- 日志 ----------------
LOG_LEVEL=INFO
LOG_FILE=./data/dbsync.log

# ---------------- 安全（必填！） ----------------
# 生产模式（DEBUG=false）下，未设置或过短的 SECRET_KEY 会导致服务拒绝启动。
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-env

# 令牌有效期（分钟）
ACCESS_TOKEN_EXPIRE_MINUTES=60

# 登录失败限流：窗口内超过次数则暂时拒绝
LOGIN_MAX_ATTEMPTS=10
LOGIN_WINDOW_SECONDS=300

# 跨域白名单（逗号分隔）。留空表示不启用 CORS——本应用为同源部署，通常无需设置。
CORS_ORIGINS=

# ---------------- 同步引擎 ----------------
# 并发同步任务上限（pymysqlreplication 为纯 Python 解析，受 GIL 限制）
SYNC_MAX_TASKS=8
# 单事务缓冲行数上限，超过则提前提交（牺牲原子性换取资源安全）
SYNC_TX_MAX_ROWS=10000
# 位点落盘间隔（秒）
SYNC_CHECKPOINT_INTERVAL=2.0
# 重连退避
SYNC_RETRY_BASE_DELAY=2.0
SYNC_RETRY_MAX_DELAY=60.0
# binlog 心跳间隔（秒）。源库会按 wait_timeout 掐断空闲的复制连接，
# 保持心跳可避免这种无谓断连。须小于源库 wait_timeout 的一半。
SYNC_HEARTBEAT_SECONDS=15.0
# 同步线程意外死亡后的自动重启上限与退避基准（秒）。
# 设为 0 关闭自愈。重试从最后已提交位点继续，写入幂等，无重复副作用。
SYNC_AUTO_RECOVER_MAX=5
SYNC_AUTO_RECOVER_DELAY=10.0
# 失败事件队列上限
DLQ_MAX_ROWS=100000
