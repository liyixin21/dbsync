# DBSync 环境配置
# 复制此文件为 .env 并修改配置

# 应用配置
APP_NAME=数据库同步备份工具
APP_VERSION=1.0.0
DEBUG=false

# 服务器配置
HOST=0.0.0.0
PORT=8000

# SQLite 数据库路径
DATABASE_URL=sqlite:///./data/dbsync.db

# 备份目录
BACKUP_DIR=./backups
MAX_BACKUP_FILES=100

# 日志配置
LOG_LEVEL=INFO
LOG_FILE=./data/dbsync.log

# 安全配置（务必设置随机密钥！）
# 生成方式: python -c "import secrets; print(secrets.token_urlsafe(32))"
SECRET_KEY=change-me-in-production-env
ACCESS_TOKEN_EXPIRE_MINUTES=60
